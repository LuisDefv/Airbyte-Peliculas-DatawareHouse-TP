table fact_titulo
	lineageTag: 1d7fc4bb-228b-423c-93e1-e66baa9cbc04

	measure 'Total Títulos' = COUNTROWS(fact_titulo)
		formatString: #,0
		lineageTag: 21de38e2-fb53-4bf9-a6af-ab6adbed65c2

	measure Películas = CALCULATE([Total Títulos], KEEPFILTERS(fact_titulo[tipo] = "Película")) + 0
		formatString: #,0
		lineageTag: 3267dab2-2d32-4bfa-b9bd-c76cf3dc4831

	measure Series = CALCULATE([Total Títulos], KEEPFILTERS(fact_titulo[tipo] = "Serie")) + 0
		formatString: #,0
		lineageTag: a2f75401-c37a-4430-9171-a9a74ab2142b

	measure '% Series' = DIVIDE([Series], [Total Títulos])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4d06dc29-b47d-45aa-954b-5ca797e86c8d

	measure 'Duración Prom (min)' = AVERAGE(fact_titulo[duracion_min])
		formatString: #,0.0
		lineageTag: 83e781b6-fce9-4714-803e-4a6ce61580e0

	measure 'Temporadas Prom' = AVERAGE(fact_titulo[temporadas])
		formatString: #,0.00
		lineageTag: 030c15cc-e503-4c2d-8c6d-8a8301bad574

	measure '% del catálogo' = DIVIDE([Total Títulos], CALCULATE([Total Títulos], REMOVEFILTERS(dim_genero), REMOVEFILTERS(dim_clasificacion), REMOVEFILTERS(dim_pais), REMOVEFILTERS(dim_anio)))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5dc4b14b-6641-43d4-a776-8938879454c4

