{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "lineaAnio",
  "position": {
    "x": 20,
    "y": 180,
    "z": 7000,
    "height": 260,
    "width": 790,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_fecha"
                    }
                  },
                  "Property": "anio"
                }
              },
              "queryRef": "dim_fecha.anio",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_titulos"
                    }
                  },
                  "Property": "tipo"
                }
              },
              "queryRef": "fact_titulos.tipo"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_titulos"
                    }
                  },
                  "Property": "Total Títulos"
                }
              },
              "queryRef": "fact_titulos.Total Títulos"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Crecimiento del catálogo por año'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}