{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "donaClasif",
  "position": {
    "x": 820,
    "y": 130,
    "z": 8000,
    "height": 310,
    "width": 440,
    "tabOrder": 7000
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_titulos"
                    }
                  },
                  "Property": "clasificacion"
                }
              },
              "queryRef": "fact_titulos.clasificacion",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_titulos"
                    }
                  },
                  "Property": "Total Títulos"
                }
              },
              "queryRef": "fact_titulos.Total Títulos"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Títulos por clasificación'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}