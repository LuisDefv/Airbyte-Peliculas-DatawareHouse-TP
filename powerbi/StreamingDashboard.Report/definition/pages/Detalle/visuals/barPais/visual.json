{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "barPais",
  "position": {
    "x": 20,
    "y": 418,
    "z": 3000,
    "height": 292,
    "width": 560,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_pais"
                    }
                  },
                  "Property": "pais"
                }
              },
              "queryRef": "dim_pais.pais",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_plataforma"
                    }
                  },
                  "Property": "plataforma"
                }
              },
              "queryRef": "dim_plataforma.plataforma"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_titulo"
                    }
                  },
                  "Property": "Total Títulos"
                }
              },
              "queryRef": "fact_titulo.Total Títulos"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "fact_titulo"
                  }
                },
                "Property": "Total Títulos"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Países de producción (títulos con país informado)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}