{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "colDecada",
  "position": {
    "x": 800,
    "y": 128,
    "z": 2200,
    "height": 280,
    "width": 460,
    "tabOrder": 2200
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_anio"
                    }
                  },
                  "Property": "periodo"
                }
              },
              "queryRef": "dim_anio.periodo",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_plataforma"
                    }
                  },
                  "Property": "plataforma"
                }
              },
              "queryRef": "dim_plataforma.plataforma"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_titulo"
                    }
                  },
                  "Property": "% del catálogo"
                }
              },
              "queryRef": "fact_titulo.% del catálogo"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Antigüedad del catálogo (% por período de estreno)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}