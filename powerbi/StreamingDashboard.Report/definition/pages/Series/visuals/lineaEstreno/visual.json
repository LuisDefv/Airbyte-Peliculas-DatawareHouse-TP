{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "lineaEstreno",
  "position": {
    "x": 430,
    "y": 168,
    "z": 3000,
    "height": 270,
    "width": 830,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_anio"
                    }
                  },
                  "Property": "anio"
                }
              },
              "queryRef": "dim_anio.anio",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_plataforma"
                    }
                  },
                  "Property": "plataforma"
                }
              },
              "queryRef": "dim_plataforma.plataforma"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_titulo"
                    }
                  },
                  "Property": "Total Títulos"
                }
              },
              "queryRef": "fact_titulo.Total Títulos"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Títulos por año de estreno'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}