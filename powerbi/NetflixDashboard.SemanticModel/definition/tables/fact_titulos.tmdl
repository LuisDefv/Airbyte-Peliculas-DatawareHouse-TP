table fact_titulos
	lineageTag: 39116236-930e-4fa7-bcb1-d1b1e5a5f801

	measure 'Total Títulos' = COUNTROWS(fact_titulos)
		formatString: #,0
		lineageTag: a8d493ba-1e08-4784-8e3d-de266a17cd17

	measure Películas = CALCULATE([Total Títulos], fact_titulos[tipo] = "Película")
		formatString: #,0
		lineageTag: ab2fa640-9704-4301-b048-b017f74b3be8

	measure Series = CALCULATE([Total Títulos], fact_titulos[tipo] = "Serie")
		formatString: #,0
		lineageTag: 50f57ca0-dff9-421b-8f89-462642e5f861

	measure '% Películas' = DIVIDE([Películas], [Total Títulos])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1bd072a0-040e-4395-9190-35468d349838

	measure 'Duración Prom' = AVERAGE(fact_titulos[duracion_min])
		formatString: #,0.0
		lineageTag: 2effc031-eecc-4e72-a159-e17d8a15c79c

	measure 'Temporadas Prom' = AVERAGE(fact_titulos[temporadas])
		formatString: #,0.0
		lineageTag: bef9408b-986d-44e5-bab1-e114e8957d44

