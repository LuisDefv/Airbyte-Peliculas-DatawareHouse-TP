model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fact_titulos","dim_fecha","dim_genero","bridge_titulo_genero","dim_pais","bridge_titulo_pais"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_titulos
ref table dim_fecha
ref table dim_genero
ref table bridge_titulo_genero
ref table dim_pais
ref table bridge_titulo_pais

